{
  "name": "tingque-open-tool",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "description": "TingQue Japanese mahjong AI analysis and training toolkit",
  "license": "MIT",
  "homepage": "https://tingque.ai",
  "engines": {
    "node": ">=22.13.0 <23 || >=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "build:standalone": "tsc --noEmit && vite build --mode standalone",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest",
    "test:parity": "tsx scripts/check-parity.ts",
    "check:copy": "node scripts/check-public-copy.mjs",
    "verify": "npm run lint && npm run typecheck && npm test -- --run && npm run test:parity && npm run check:copy && npm run test:release && npm run build && npm run build:standalone",
    "test:browser": "playwright test",
    "package:release": "npm run typecheck && node scripts/package-release.mjs",
    "test:release": "node --test scripts/test-release-build.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "overrides": {
    "esbuild": "0.28.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "globals": "17.4.0",
    "jsdom": "26.1.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "5.0.1"
  }
}
